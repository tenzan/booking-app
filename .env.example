# LOCAL DEVELOPMENT ONLY: copy to .env to run the app, tests and seed on your machine.
# Every value below is a placeholder; none of them is needed for local runs except MAIL_MODE=dev.
# Production values live in your secret manager (e.g. Doppler) and are injected with `doppler run -- npm run deploy`
# (see docs/SETUP.md). Do not keep this file's values in the environment you deploy from: `npm run deploy` renders
# with `--strict`, which refuses MAIL_MODE=dev, all-zero IDs and REPLACE_ME*/SET_BY* placeholders.

# Custom domain the Worker is served on (base URL becomes https://APP_DOMAIN)
APP_DOMAIN=booking.example.com
# Initial organisation name (editable in settings afterwards)
ORG_NAME=Example Support
# Sender address; also the only address the send_email binding may use
MAIL_FROM=no-reply@booking.example.com
# Display name for outgoing mail
MAIL_FROM_NAME=Example Support
# Team mailbox that inbound replies are forwarded to (optional)
MAIL_REPLY_FORWARD_TO=team@example.com
# dev = local mailbox at http://localhost:5173/dev/mail (works only when the app runs on localhost/127.0.0.1).
# Production MUST use cloudflare; `--strict` (npm run deploy) enforces it.
MAIL_MODE=dev
# IANA timezone for the schedule and for times shown to users
APP_TIMEZONE=UTC
# UI and email language
APP_LOCALE=en
# Cloudflare account that owns the Worker and D1 database
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
# D1 database UUID (from `wrangler d1 create`)
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
# Turnstile site key (optional; public)
TURNSTILE_SITE_KEY=
# Secret (deploy only; not needed locally): custom API token with the account and zone permissions listed in
# docs/SETUP.md section 1 (Workers Scripts, D1, Turnstile, Email Sending/Routing, DNS, Workers Routes, ...)
CLOUDFLARE_API_TOKEN=
# Secret: Turnstile secret key (optional; bot protection is skipped when empty)
TURNSTILE_SECRET_KEY=
# Secret: comma-separated emails that become the first administrators
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
