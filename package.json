{
  "name": "remote-support-booking",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "config": "node scripts/render-wrangler.mjs",
    "dev": "npm run config && wrangler d1 migrations apply DB --local && vite",
    "build": "npm run config && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run config && vitest run",
    "test:watch": "npm run config && vitest",
    "test:scripts": "node --test scripts/render-wrangler.test.mjs",
    "e2e": "playwright test",
    "seed": "npm run config && node scripts/seed-dev.mjs",
    "deploy": "node scripts/render-wrangler.mjs --strict && vite build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@tanstack/react-query": "^5.104.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "~4.1.11",
    "wrangler": "^4.145.0"
  }
}
